// index.mjs — AWS Lambda (Node.js 22.x/24.x) for the Travel Intelligence Lex bot
// Single handler, 6 intents. Built-in global fetch — no npm deps.

const OPENWEATHER_API_KEY = process.env.OPENWEATHER_API_KEY;

/* ---------- helpers ---------- */

function getSlot(slots, name) {
  return slots?.[name]?.value?.interpretedValue ?? slots?.[name]?.value?.originalValue ?? null;
}

function close(intentName, message, sessionAttributes = {}) {
  return {
    sessionState: {
      sessionAttributes,
      dialogAction: { type: "Close" },
      intent: { name: intentName, state: "Fulfilled" }
    },
    messages: [{ contentType: "PlainText", content: message }]
  };
}

// Fetch + parse JSON without ever throwing (returns null on any failure)
async function safeJson(url, options) {
  try {
    const res = await fetch(url, options);
    if (!res.ok) return null;
    return await res.json();
  } catch (e) {
    console.error("safeJson failed:", url, e?.message);
    return null;
  }
}

/* ---------- intent logic ---------- */

async function handleCountryInfo(slots) {
  const country = getSlot(slots, "target_countries");
  const item = (getSlot(slots, "item") || "all").toLowerCase();
  if (!country) return "Which country would you like to know about?";

  // Source A — restcountries (rich fields, sometimes flaky)
  const rc = await safeJson(
    `https://restcountries.com/v3.1/name/${encodeURIComponent(country)}` +
    `?fields=name,capital,currencies,languages,population,region,subregion,timezones,area`
  );
  const a = Array.isArray(rc)
    ? (rc.find(c => (c?.name?.common || "").toLowerCase() === country.toLowerCase()) || rc[0])
    : (rc || null);

  // Source B — countriesnow.space (reliable keyless fallback)
  const post = { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ country }) };
  const [capB, curB, popB] = await Promise.all([
    safeJson("https://countriesnow.space/api/v0.1/countries/capital", post),
    safeJson("https://countriesnow.space/api/v0.1/countries/currency", post),
    safeJson("https://countriesnow.space/api/v0.1/countries/population", post)
  ]);

  const name = a?.name?.common || capB?.data?.name || curB?.data?.name || country;

  // capital: A first, then B
  let capital = "N/A";
  if (Array.isArray(a?.capital) && a.capital[0]) capital = a.capital[0];
  else if (typeof a?.capital === "string" && a.capital) capital = a.capital;
  else if (capB?.data?.capital) capital = capB.data.capital;

  // currency: A first (name + code), then B (code)
  let currency = "N/A";
  if (a?.currencies && typeof a.currencies === "object" && Object.keys(a.currencies).length) {
    currency = Object.entries(a.currencies)
      .map(([code, c]) => `${c.name} (${code}${c.symbol ? ", " + c.symbol : ""})`).join(", ");
  } else if (curB?.data?.currency) {
    currency = curB.data.currency;
  }

  // population: A first, then B (latest yearly count)
  let population = "N/A";
  if (a?.population) {
    population = Number(a.population).toLocaleString();
  } else {
    const counts = popB?.data?.populationCounts;
    if (Array.isArray(counts) && counts.length) {
      population = Number(counts[counts.length - 1].value).toLocaleString();
    }
  }

  // language / region / timezone / area: from restcountries only
  let language = "N/A";
  if (a?.languages) {
    language = Array.isArray(a.languages)
      ? a.languages.map(l => l.name || l).join(", ")
      : Object.values(a.languages).join(", ");
  }
  const region   = a?.subregion ? `${a.region} (${a.subregion})` : (a?.region || "N/A");
  const timezone = Array.isArray(a?.timezones) ? a.timezones.join(", ") : "N/A";
  const area     = a?.area ? `${Number(a.area).toLocaleString()} km²` : "N/A";

  switch (item) {
    case "capital":    return `The capital of ${name} is ${capital}.`;
    case "currency":   return `The currency of ${name} is ${currency}.`;
    case "language":   return `The official language(s) of ${name}: ${language}.`;
    case "population": return `The population of ${name} is ${population}.`;
    case "region":     return `${name} is located in ${region}.`;
    case "timezone":   return `Timezone(s) for ${name}: ${timezone}.`;
    case "area":       return `The area of ${name} is ${area}.`;
    default:
      return `Here is what I found about ${name}:
• Capital: ${capital}
• Currency: ${currency}
• Language(s): ${language}
• Population: ${population}
• Region: ${region}
• Timezone(s): ${timezone}
• Area: ${area}`;
  }
}

async function handleWeatherInfo(slots) {
  const city = getSlot(slots, "city");
  if (!city) return "Which city's weather would you like to know?";
  if (!OPENWEATHER_API_KEY) return "Weather lookup isn't configured — please set the OPENWEATHER_API_KEY environment variable.";

  const d = await safeJson(
    `https://api.openweathermap.org/data/2.5/weather?q=${encodeURIComponent(city)}&appid=${OPENWEATHER_API_KEY}&units=metric`
  );
  if (!d || !d.main) return `Sorry, I couldn't get the weather for "${city}".`;

  const desc  = d.weather?.[0]?.description || "unknown conditions";
  const temp  = Math.round(d.main.temp);
  const feels = Math.round(d.main.feels_like);
  return `The weather in ${d.name} is ${temp}°C (feels like ${feels}°C) with ${desc}. Humidity ${d.main.humidity}%, wind ${d.wind?.speed} m/s.`;
}

async function handleCurrencyConversion(slots) {
  const amount = parseFloat(getSlot(slots, "amount")) || 1;
  const from = (getSlot(slots, "from_currency") || "").toUpperCase();
  const to   = (getSlot(slots, "to_currency") || "").toUpperCase();
  if (!from || !to) return "Please tell me which currencies to convert from and to (e.g., USD to EUR).";

  const data = await safeJson(`https://api.exchangerate-api.com/v4/latest/${encodeURIComponent(from)}`);
  const rate = data?.rates?.[to];
  if (!rate) return `I couldn't find a rate from ${from} to ${to}. Please check the currency codes.`;

  return `${amount} ${from} = ${(amount * rate).toFixed(2)} ${to} (rate: 1 ${from} = ${rate} ${to}).`;
}

function handleTravelRecommendations(slots) {
  const budget    = (getSlot(slots, "budget") || "moderate").toLowerCase();
  const interests = (getSlot(slots, "interests") || "culture").toLowerCase();

  const byInterest = {
    adventure:  ["Queenstown, New Zealand", "Interlaken, Switzerland", "Moab, USA"],
    culture:    ["Kyoto, Japan", "Rome, Italy", "Istanbul, Turkey"],
    relaxation: ["Bali, Indonesia", "Maldives", "Santorini, Greece"],
    food:       ["Bangkok, Thailand", "Bologna, Italy", "Oaxaca, Mexico"],
    nature:     ["Banff, Canada", "Costa Rica", "Norwegian Fjords"],
    history:    ["Cairo, Egypt", "Athens, Greece", "Cusco, Peru"],
    shopping:   ["Dubai, UAE", "Tokyo, Japan", "Milan, Italy"]
  };
  const budgetNote = {
    budget:     "great-value stays and street food",
    backpacker: "hostels and public transport",
    moderate:   "comfortable 3-star hotels and mixed dining",
    luxury:     "5-star resorts and private experiences"
  };

  const picks = byInterest[interests] || byInterest.culture;
  const note  = budgetNote[budget] || budgetNote.moderate;
  return `For ${interests} on a ${budget} budget, try: ${picks.join(", ")}. Expect ${note}.`;
}

function handleFlightStatus(slots) {
  const flight = (getSlot(slots, "flight_number") || "").toUpperCase();
  if (!flight) return "What is your flight number? (e.g., AA123)";

  const statuses = ["On Time", "Delayed by 20 minutes", "Boarding", "Departed", "Landed"];
  const gates    = ["A12", "B4", "C21", "D7", "E15"];
  const i = [...flight].reduce((s, ch) => s + ch.charCodeAt(0), 0);
  return `Flight ${flight} is "${statuses[i % statuses.length]}" (gate ${gates[i % gates.length]}). [Demo data — connect a flight API for live status.]`;
}

function handleTravelItinerary(slots) {
  const destination = getSlot(slots, "destination") || "your destination";
  const days = Math.max(1, Math.min(7, parseInt(getSlot(slots, "duration")) || 3));

  const themes = [
    "Arrival & old-town walking tour",
    "Top museums & landmarks",
    "Local food market & cooking experience",
    "Day trip to nearby nature or coast",
    "Neighborhood exploration & shopping",
    "Hidden gems & local cafés",
    "Relaxation & departure"
  ];
  let plan = `Here's a ${days}-day itinerary for ${destination}:\n`;
  for (let d = 1; d <= days; d++) plan += `• Day ${d}: ${themes[(d - 1) % themes.length]}\n`;
  return plan.trim();
}

/* ---------- main handler (the ONLY one) ---------- */

export const handler = async (event) => {
  const intentName        = event?.sessionState?.intent?.name;
  const slots             = event?.sessionState?.intent?.slots || {};
  const sessionAttributes = event?.sessionState?.sessionAttributes || {};

  let message;
  try {
    switch (intentName) {
      case "CountryInfo":           message = await handleCountryInfo(slots); break;
      case "WeatherInfo":           message = await handleWeatherInfo(slots); break;
      case "CurrencyConversion":    message = await handleCurrencyConversion(slots); break;
      case "TravelRecommendations": message = handleTravelRecommendations(slots); break;
      case "FlightStatus":          message = handleFlightStatus(slots); break;
      case "TravelItinerary":       message = handleTravelItinerary(slots); break;
      default:
        message = "I can help with country info, weather, currency conversion, travel recommendations, flight status, or itineraries. Please try one of those.";
    }
  } catch (err) {
    console.error("Handler error:", err);
    message = "Something went wrong while fetching that information. Please try again.";
  }

  return close(intentName || "FallbackIntent", message, sessionAttributes);
};
